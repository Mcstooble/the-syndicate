---
import { site } from "../../content/site.ts";
const { experience } = site;
// Six neutral placeholder tiles. Width varies to read like a wall of real
// wordmarks rather than identical boxes.
const tiles = [
  { w: "w-28" },
  { w: "w-20" },
  { w: "w-32" },
  { w: "w-24" },
  { w: "w-28" },
  { w: "w-20" },
];
---
<!-- TODO: replace placeholder logos + add outcome stats once Wayne confirms namable clients (Wayflyer, Back Market, Fuel Labs, Microverse, ...) -->
<section id="experience" class="bg-paper px-6 py-28 sm:py-36">
  <div class="mx-auto max-w-content">
    <div class="max-w-3xl" data-reveal>
      <span class="eyebrow">{experience.eyebrow}</span>
      <h2 class="mt-6 text-3xl font-medium leading-[1.1] sm:text-5xl sm:leading-[1.08]">
        {experience.headline}
      </h2>
      <p class="mt-6 max-w-xl text-base leading-relaxed text-mist sm:text-lg">
        {experience.note}
      </p>
    </div>

    <div class="mt-16 grid grid-cols-2 gap-px overflow-hidden rounded-sm bg-ink/10 sm:grid-cols-3" data-reveal>
      {tiles.map((t, i) => (
        <div
          class="flex aspect-[2/1] items-center justify-center bg-canvas"
          style={`--reveal-delay:${i * 60}ms`}
          aria-hidden="true"
        >
          <span class={`block h-3.5 rounded-full bg-sky ${t.w}`}></span>
        </div>
      ))}
    </div>
    <p class="sr-only">Logos of past clients are not yet shown publicly.</p>
  </div>
</section>
