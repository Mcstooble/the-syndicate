---
import { site } from "../../content/site.ts";
const { about } = site;
---
<section id="about" class="bg-paper px-6 py-28 sm:py-36">
  <div class="mx-auto grid max-w-content gap-12 md:grid-cols-[16rem_1fr] md:gap-16">
    <div class="md:sticky md:top-28 md:self-start" data-reveal>
      <span class="eyebrow">{about.eyebrow}</span>
    </div>
    <div>
      <h2
        class="max-w-3xl text-3xl font-medium leading-[1.1] sm:text-5xl sm:leading-[1.08]"
        data-reveal
      >
        {about.headline}
      </h2>
      <div class="mt-10 max-w-2xl space-y-6 text-lg leading-relaxed text-slate">
        {about.body.map((p, i) => (
          <p data-reveal style={`--reveal-delay:${100 + i * 100}ms`}>{p}</p>
        ))}
      </div>
    </div>
  </div>
</section>
