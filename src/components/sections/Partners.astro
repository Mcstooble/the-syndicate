---
import { site } from "../../content/site.ts";
const { partners } = site;
---
<section id="partners" class="bg-canvas px-6 py-28 sm:py-36">
  <div class="mx-auto max-w-content">
    <div class="max-w-3xl" data-reveal>
      <span class="eyebrow">The partners</span>
      <h2 class="mt-6 text-3xl font-medium leading-[1.1] sm:text-5xl sm:leading-[1.08]">
        Two operators. One table.
      </h2>
    </div>

    <div class="mt-16 grid gap-px overflow-hidden rounded-sm bg-ink/10 sm:grid-cols-2">
      {partners.map((p, i) => (
        <article
          class="flex flex-col bg-paper p-8 sm:p-12"
          data-reveal
          style={`--reveal-delay:${i * 90}ms`}
        >
          <!-- TODO: swap monogram avatars for real founder photos in public/partners/ -->
          <span
            class="flex h-16 w-16 items-center justify-center rounded-full bg-sky font-display text-lg font-medium tracking-tight text-ink"
            aria-hidden="true"
          >
            {p.monogram}
          </span>
          <h3 class="mt-7 text-2xl font-medium leading-tight">{p.name}</h3>
          <p class="mt-1 text-sm font-medium uppercase tracking-[0.16em] text-gold">{p.role}</p>
          <p class="mt-5 max-w-md text-base leading-relaxed text-slate sm:text-lg">{p.body}</p>
        </article>
      ))}
    </div>
  </div>
</section>
