---
import { site } from "../../content/site.ts";
const { process } = site;
---
<section id="process" class="bg-paper px-6 py-28 sm:py-36">
  <div class="mx-auto max-w-content">
    <div class="md:grid md:grid-cols-[16rem_1fr] md:gap-16">
      <div class="md:sticky md:top-28 md:self-start" data-reveal>
        <span class="eyebrow">How we work</span>
      </div>
      <ol class="space-y-12 sm:space-y-0">
        {process.map((p, i) => (
          <li
            class="grid grid-cols-[3.5rem_1fr] items-start gap-x-6 border-t border-ink/10 py-8 first:border-t-0 first:pt-0 sm:grid-cols-[5rem_1fr] sm:gap-x-10 sm:py-10"
            data-reveal
            style={`--reveal-delay:${i * 90}ms`}
          >
            <span class="font-display text-3xl font-medium tabular-nums text-gold sm:text-5xl" aria-hidden="true">
              {p.step}
            </span>
            <div>
              <h3 class="text-2xl font-medium leading-tight sm:text-3xl">{p.title}</h3>
              <p class="mt-3 max-w-xl text-base leading-relaxed text-slate sm:text-lg">
                {i === 0 ? (
                  <>
                    We start with your real challenge, not a sales script.{" "}
                    <span class="font-medium text-ink">The first session is free</span>, and you walk away with something useful whether we work together or not.
                  </>
                ) : (
                  p.body
                )}
              </p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>
