---
import { site } from "../../content/site.ts";
const { services } = site;
---
<section id="services" class="bg-canvas px-6 py-28 sm:py-36">
  <div class="mx-auto max-w-content">
    <div class="md:grid md:grid-cols-[16rem_1fr] md:gap-16">
      <div class="md:sticky md:top-28 md:self-start" data-reveal>
        <span class="eyebrow">What we do</span>
      </div>
      <div>
        <h2 class="max-w-2xl text-3xl font-medium leading-[1.1] sm:text-5xl sm:leading-[1.08]" data-reveal>
          Partners for the zero-to-one stretch.
        </h2>

        <ul class="mt-14 border-t border-ink/10">
          {services.map((s, i) => (
            <li>
              <article
                class="group grid grid-cols-[2.5rem_1fr] items-baseline gap-x-5 gap-y-2 border-b border-ink/10 py-7 sm:grid-cols-[3.5rem_1fr] sm:gap-x-8 sm:py-9"
                data-reveal
                style={`--reveal-delay:${i * 70}ms`}
              >
                <span
                  class="font-display text-base font-medium tabular-nums text-gold sm:text-lg"
                  aria-hidden="true"
                >
                  {String(i + 1).padStart(2, "0")}
                </span>
                <h3 class="text-xl font-medium leading-snug sm:text-2xl">
                  {s.title}
                </h3>
                <p class="col-start-2 max-w-xl text-base leading-relaxed text-slate sm:text-lg">
                  {s.outcome}
                </p>
              </article>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>
